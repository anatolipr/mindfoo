{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "useDefineForClassFields": false,
      "experimentalDecorators": false,
      "resolveJsonModule": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "allowJs": true,
      "checkJs": true,
      "isolatedModules": true
    },
    "include": ["src/**/*.ts", "src/**/*.js"],
    "references": [{ "path": "./tsconfig.node.json" }]
  }
  